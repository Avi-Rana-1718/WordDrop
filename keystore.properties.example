# Copy to keystore.properties (git-ignored) and fill in. Path is relative to the project root.
#
# Create the upload key once and back it up somewhere safe — losing it means you cannot
# push updates without going through Play's key-reset process:
#
#   keytool -genkeypair -v -keystore worddrop-upload.jks -alias worddrop \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=worddrop-upload.jks
storePassword=CHANGE_ME
keyAlias=worddrop
keyPassword=CHANGE_ME
