<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11 auto-backup. Word bank reseeds from assets; saved words, progress and settings are
     what the user would miss. Room's WAL sidecar files are excluded so the restored DB is consistent. -->
<full-backup-content>
    <include domain="database" path="worddrop.db" />
    <include domain="file" path="datastore/worddrop_prefs.preferences_pb" />
    <exclude domain="database" path="worddrop.db-wal" />
    <exclude domain="database" path="worddrop.db-shm" />
    <exclude domain="database" path="worddrop.db-journal" />
</full-backup-content>
